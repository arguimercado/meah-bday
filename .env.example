# Neon connection string (Neon console → your project → Connect)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Password for the /admin guest list page
ADMIN_PASSWORD="choose-a-strong-password"

# Optional: your custom domain (e.g. https://darlyn7.com) so link previews use it.
# On Vercel the production domain is used automatically.
# SITE_URL="https://your-domain.com"
